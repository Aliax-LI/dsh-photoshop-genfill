{
  "name": "@local/dsh-photoshop-genfill",
  "version": "1.0.0",
  "private": true,
  "description": "Image-grounded Photoshop retouch agent for DeepSeek Harness: native photoshop-mcp tools, verified canvas previews, and optional OpenAI-compatible image editing.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliax-LI/dsh-photoshop-genfill.git"
  },
  "bugs": {
    "url": "https://github.com/Aliax-LI/dsh-photoshop-genfill/issues"
  },
  "homepage": "https://github.com/Aliax-LI/dsh-photoshop-genfill#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "photoshop",
    "retouch",
    "photo-editing",
    "gpt-image-2",
    "image-generation",
    "mcp"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "CONTRACT.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
